# Copia este archivo a .env y ajusta los valores.
# Las credenciales de AWS NO se guardan aquí: se leen de ~/.aws
# (o de las variables AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY si las defines).

# --- AWS ---
AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/137696817246/kenko-dev-notifications-authentication
SES_SENDER=kenko.salud.eps@gmail.com

# --- Contenido del correo ---
APP_NAME=Kenko
KENKO_PORTAL_URL=https://kenko.example.com
KENKO_SUPPORT_EMAIL=soporte@kenko.example.com
LOGO_URL=https://cdn.kenko.example.com/img/kenko_limpio.png

# --- Worker ---
LOG_LEVEL=INFO
RECEIVE_BATCH_SIZE=1
RECEIVE_WAIT_TIME_SECONDS=20

# --- Persistencia (opcional) ---
# Si se omite se usa un repositorio en memoria: sirve para desarrollo y pruebas,
# pero la idempotencia NO sobrevive a un reinicio del worker.
# DATABASE_URL=postgresql+psycopg2://notifications:secret@localhost:5432/notifications
