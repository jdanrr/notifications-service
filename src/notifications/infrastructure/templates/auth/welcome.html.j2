{% extends "_base.html.j2" %}
{% block subject %}Bienvenido a {{ app_name | default('Kenko') }}{% endblock %}
{% block preheader %}Hola {{ user_name | default('') }} — tu cuenta en {{ app_name | default('Kenko') }} ya está lista.{% endblock %}
{% block content %}
<h1 style="margin:0 0 12px 0;font-size:22px;line-height:1.3;color:#224a5b;">Hola{% if user_name %}, {{ user_name }}{% endif %} — ¡bienvenido a {{ app_name | default('Kenko') }}!</h1>
<p style="margin:0 0 12px 0;">Tu cuenta{% if email %} (<strong>{{ email }}</strong>){% endif %} fue creada correctamente. Ya puedes acceder al portal de salud para gestionar tus citas, autorizaciones, certificados e historia clínica.</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:20px 0;">
  <tr>
    <td align="center" style="background-color:#295fc3;border-radius:8px;">
      <a href="{{ portal_url }}" style="display:inline-block;padding:12px 24px;color:#ffffff;text-decoration:none;font-weight:bold;font-size:15px;">Ingresar al portal</a>
    </td>
  </tr>
</table>
<p style="margin:0 0 12px 0;">Si el botón no funciona, copia y pega este enlace en tu navegador:<br><a href="{{ portal_url }}" style="color:#295fc3;word-break:break-all;">{{ portal_url }}</a></p>
<p style="margin:0;">Si tú no creaste esta cuenta, ignora este mensaje o contáctanos a <a href="mailto:{{ support_email }}" style="color:#295fc3;">{{ support_email }}</a>.</p>
{% endblock %}
