{# Cita reprogramada. Requerido: user_name, appointment_type, date, start_time, end_time.
Opcional: weekday, previous_date, previous_start_time, previous_end_time,
physician_name, medical_center_name, medical_center_location.
Marca: app_name, portal_url, support_email, logo_url, current_year. #}
{% extends "_base.html.j2" %}
{% block subject %}Tu cita de {{ appointment_type }} fue reprogramada{% endblock %}
{% block preheader %}Hola {{ user_name }} — tu nueva fecha es el {{ date }} a las {{ start_time }}.{% endblock %}
{% block content %}
<h1 style="margin:0 0 12px 0;font-size:22px;line-height:1.3;color:#224a5b;">Hola {{ user_name }} — tu cita fue reprogramada</h1>
{% if previous_date | default('') %}
<p style="margin:0 0 12px 0;">Fecha anterior: <s>{{ previous_date }}{% if previous_start_time | default('') %} a las {{ previous_start_time }}{% endif %}</s></p>
{% endif %}
<p style="margin:0 0 12px 0;">Nuevos datos de tu cita en {{ app_name | default('Kenko') }}:</p>
<ul style="margin:0 0 12px 0;padding-left:20px;">
  <li><strong>Tipo:</strong> {{ appointment_type }}</li>
  <li><strong>Fecha:</strong> {{ date }}{% if weekday | default('') %} ({{ weekday }}){% endif %}</li>
  <li><strong>Hora:</strong> {{ start_time }} – {{ end_time }}</li>
  <li><strong>Médico:</strong> {{ physician_name | default('Por asignar', true) }}</li>
  <li><strong>Centro:</strong> {{ medical_center_name | default('Por confirmar', true) }}{% if medical_center_location | default('') %} — {{ medical_center_location }}{% endif %}</li>
</ul>
<p style="margin:0;">Llega 15 minutos antes con tu documento de identidad. Si no puedes asistir, cancela o reprograma desde el portal: <a href="{{ portal_url }}" style="color:#295fc3;">{{ portal_url }}</a></p>
{% endblock %}
