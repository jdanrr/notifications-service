<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <title>{% block subject %}Kenko{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background-color:#f2f4f7;">
  <span style="display:none;max-height:0;overflow:hidden;opacity:0;">{% block preheader %}Notificación de Kenko{% endblock %}</span>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f2f4f7;margin:0;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background-color:#ffffff;border-radius:12px;overflow:hidden;">
          <tr>
            <td align="center" style="padding:24px 32px 8px 32px;background-color:#ffffff;">
              <img src="{{ logo_url }}" alt="Kenko" width="140" style="display:block;width:140px;height:auto;border:0;">
            </td>
          </tr>
          <tr>
            <td style="padding:8px 32px 24px 32px;font-family:Arial,Helvetica,sans-serif;color:#224a5b;font-size:15px;line-height:1.6;">
              {% block content %}{% endblock %}
            </td>
          </tr>
          <tr>
            <td style="padding:16px 32px 24px 32px;font-family:Arial,Helvetica,sans-serif;color:#6b7a90;font-size:12px;line-height:1.6;border-top:1px solid #e6ebf1;">
              <p style="margin:0 0 4px 0;">Este es un mensaje automático de {{ app_name | default('Kenko') }}, por favor no respondas a este correo.</p>
              <p style="margin:0 0 4px 0;">¿Necesitas ayuda? Escríbenos a <a href="mailto:{{ support_email }}" style="color:#295fc3;">{{ support_email }}</a>{% if portal_url %} o ingresa a <a href="{{ portal_url }}" style="color:#295fc3;">{{ portal_url }}</a>{% endif %}.</p>
              <p style="margin:8px 0 0 0;">© {{ current_year }} {{ app_name | default('Kenko') }} EPS · Colombia</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
